{
  "name": "ai-learning-hub",
  "version": "0.1.0",
  "description": "Artificial Intelligence Learning Hub",
  "author": "Aji Pamungkas Tri Nurcahyo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8933",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:content": "node scripts/validate.mjs && node scripts/check-formatting.mjs",
    "check:resources": "node scripts/validate.mjs",
    "check:presentations": "node scripts/validate.mjs",
    "test": "node --test scripts/tests.mjs",
    "build": "npm run check:content && npm run typecheck && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8933",
    "test:http": "node scripts/test-http.mjs",
    "check:licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/material-symbols-rounded": "^5.3.9",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reveal.js": "^6.0.2",
    "shiki": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5"
  }
}
